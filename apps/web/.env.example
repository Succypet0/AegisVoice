# AegisVoice Web Environment Variables

# Backend API & WebSocket Base URL
# Local Development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Production (e.g. Render):
# NEXT_PUBLIC_BACKEND_URL=https://your-backend-service.onrender.com

# Optional explicit WebSocket overrides (defaults are auto-derived from NEXT_PUBLIC_BACKEND_URL)
# NEXT_PUBLIC_WS_URL=wss://your-backend-service.onrender.com/ws/guard
# NEXT_PUBLIC_DISPATCH_WS_URL=wss://your-backend-service.onrender.com/ws/dispatch
